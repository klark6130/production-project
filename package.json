        "lint-staged": "^14.0.0",
        "loki": "^0.34.0",
        "mini-css-extract-plugin": "^2.7.2",
        "prettier": "3.0.3",
        "react-refresh": "^0.14.0",
        "reg-cli": "^0.17.7",
        "regenerator-runtime": "^0.13.11",
        "sass": "^1.57.1",
        "sass-loader": "^13.2.0",
        "storybook-addon-mock": "^3.2.0",
        "storybook-addon-themes": "^6.1.0",
        "style-loader": "^3.3.1",
        "stylelint": "^14.16.1",
        "stylelint-config-standard-scss": "^6.1.0",
        "ts-loader": "^9.4.2",
        "ts-morph": "^19.0.0",
        "ts-node": "^10.9.1",
        "typescript": "^4.9.5",
        "vite": "^4.4.2",
        "vite-plugin-svgr": "^3.2.0",
        "webpack": "^5.75.0",
        "webpack-bundle-analyzer": "^4.8.0",
        "webpack-cli": "^5.0.1",
        "webpack-dev-server": "^4.11.1"
    },
    "dependencies": {
        "@headlessui/react": "^1.7.14",
        "@react-spring/web": "^9.7.3",
        "@reduxjs/toolkit": "^1.9.5",
        "@use-gesture/react": "^10.2.27",
        "axios": "^1.3.4",
        "i18next": "^22.4.9",
        "i18next-browser-languagedetector": "^7.0.1",
        "i18next-http-backend": "^2.1.1",
        "jsonwebtoken": "^9.0.0",
        "react": "^18.2.0",
        "react-device-detect": "^2.2.3",
        "react-dom": "^18.0.2",
        "react-i18next": "^12.1.5",
        "react-redux": "^8.1.2",
        "react-router-dom": "^6.2.1",
        "redux": "^4.2.1"
    },
    "lint-staged": {
        "**/*.{ts,tsx}": [
            "eslint"
        ]
    },
    "loki": {
        "configurations": {
            "chrome.laptop": {
                "target": "chrome.app",
                "width": 1366,
                "height": 768,
                "deviceScaleFactor": 1,
                "mobile": false
            },
            "chrome.iphone7": {
                "target": "chrome.app",
                "preset": "iPhone 7"
            }
        }
    }
}
