{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "ESNext",
    "target": "es5",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["jest", "node"]
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    } 
  },
  // In tsconfig.json
  "include": [
    "./config/**/*.ts",
    "./config/**/*.tsx",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./scripts/*.js",
    "./scripts/**/*.js",
  ],
  "exclude": [
    // "cypress",
    //"./cypress.config.ts",
  ]
}